{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./node_modules/oxlint-config-avi12/browser.json", "./node_modules/oxlint-plugin-naming/preset.json"],
  "overrides": [
    {
      "files": ["scripts/**", "apps/**", "curriculum/_kit/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          { "paths": [{ "name": "zod", "message": "import z from scripts/lib/zod.ts - it turns off zod's JIT before the first schema is built" }] }
        ]
      }
    },
    { "files": ["scripts/lib/zod.ts"], "rules": { "no-restricted-imports": "off" } }
  ],
  "ignorePatterns": [
    "**/node_modules/**", "**/.output/**", "**/.output-voice/**", "**/.output-test/**", "**/.wxt/**", "dist/**", "work/**",
    ".vscode-server/**", ".fallow/**", ".claude/worktrees/**", "vendor/**", "apps/vscode-ext/dist/**",
    "curriculum/*/[0-9]*/**", "apps/web/dist-client/**", "apps/web/dist-server/**"
  ]
}
