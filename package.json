{
  "name": "interview-prep",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "Hands-on interview prep: lessons, exercises and a VS Code in the browser trainer",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=24"
  },
  "imports": {
    "#scripts/*": "./scripts/*",
    "#kit/*": "./curriculum/_kit/*"
  },
  "scripts": {
    "lesson": "node scripts/lesson.ts",
    "build": "node scripts/build-lessons.ts",
    "narrate": "node scripts/narrate-lessons.ts",
    "verify": "node scripts/verify.ts",
    "start": "node scripts/start.ts",
    "dev": "node scripts/dev.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.solutions.json",
    "fallow": "fallow audit --base HEAD",
    "dev:lint": "pnpm fallow && pnpm lint",
    "prepare": "simple-git-hooks",
    "lint": "oxlint --type-aware --ignore-path .oxlintignore --fix -c .oxlintrc.fix.json && eslint --fix && oxlint --type-aware --ignore-path .oxlintignore",
    "stylelint": "stylelint \"**/*.{css,html,svelte}\" --fix"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "highlight.js": "^11.11.1",
    "marked": "^16.0.0",
    "yaml": "^2.8.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-import-newlines": "^2.0.0",
    "eslint-plugin-perfectionist": "^5.13.0",
    "eslint-plugin-svelte": "^3.23.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "fallow": "2.103.0",
    "globals": "^17.13.0",
    "lint-staged": "^17.6.0",
    "oxlint": "1.72.0",
    "oxlint-tsgolint": "0.24.0",
    "postcss": "^8.5.30",
    "postcss-html": "^1.8.1",
    "simple-git-hooks": "^2.14.0",
    "stylelint": "^17.16.0",
    "stylelint-config-ccb": "^3.32.0",
    "svelte": "^5.57.2",
    "svelte-eslint-parser": "^1.9.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.0",
    "vitest": "^3.2.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "{scripts,apps,eslint-rules,curriculum/_kit}/**/*.{ts,js,mjs,svelte}": [
      "oxlint --ignore-path .oxlintignore --fix -c .oxlintrc.fix.json",
      "eslint --fix --no-warn-ignored",
      "oxlint --ignore-path .oxlintignore"
    ],
    "eslint.config.js": [
      "oxlint --ignore-path .oxlintignore --fix -c .oxlintrc.fix.json",
      "eslint --fix --no-warn-ignored",
      "oxlint --ignore-path .oxlintignore"
    ],
    "{assets,apps}/**/*.{css,svelte}": [
      "stylelint --fix --allow-empty-input"
    ]
  }
}
