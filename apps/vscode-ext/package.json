{
  "name": "interview-prep",
  "displayName": "Interview Prep",
  "version": "0.1.0",
  "private": true,
  "description": "Narrated lessons, runnable exercises and progress for the interview-prep course",
  "categories": [
    "Education"
  ],
  "license": "Apache-2.0",
  "publisher": "avi12",
  "main": "./dist/extension.js",
  "scripts": {
    "build": "node esbuild.mjs",
    "test": "vitest run",
    "package": "pnpm build && vsce package --no-dependencies --allow-missing-repository --skip-license -o interview-prep.vsix"
  },
  "dependencies": {
    "@vscode-elements/elements": "^2.5.1"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.0"
  },
  "contributes": {
    "views": {
      "interviewPrep": [
        {
          "id": "interviewPrep.lessons",
          "name": "Lessons"
        }
      ],
      "interviewPrepResults": [
        {
          "type": "webview",
          "id": "interviewPrep.testResults",
          "name": "Test Results"
        }
      ]
    },
    "commands": [
      {
        "command": "interviewPrep.openLesson",
        "title": "Open Lesson",
        "category": "Interview Prep"
      },
      {
        "command": "interviewPrep.nextLesson",
        "title": "Open Next Lesson",
        "category": "Interview Prep",
        "icon": "$(arrow-right)"
      },
      {
        "command": "interviewPrep.goToCurrentLesson",
        "title": "Go to Current Lesson",
        "category": "Interview Prep",
        "icon": "$(target)"
      },
      {
        "command": "interviewPrep.runTests",
        "title": "Run My Tests",
        "category": "Interview Prep",
        "icon": "$(play)"
      },
      {
        "command": "interviewPrep.resetExercise",
        "title": "Reset Exercise to Starter",
        "category": "Interview Prep"
      },
      {
        "command": "interviewPrep.markDone",
        "title": "Mark Reading Lesson as Done",
        "category": "Interview Prep",
        "icon": "$(check)"
      },
      {
        "command": "interviewPrep.askClaude",
        "title": "Ask Claude (tutor)",
        "category": "Interview Prep",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "interviewPrep.chooseRole",
        "title": "Choose Role",
        "category": "Interview Prep",
        "icon": "$(person)"
      },
      {
        "command": "interviewPrep.chooseTracks",
        "title": "Choose Topics and See Progress",
        "category": "Interview Prep",
        "icon": "$(filter)"
      },
      {
        "command": "interviewPrep.addTopic",
        "title": "Add Topic",
        "category": "Interview Prep",
        "icon": "$(add)"
      },
      {
        "command": "interviewPrep.refresh",
        "title": "Refresh Lessons",
        "category": "Interview Prep",
        "icon": "$(refresh)"
      },
      {
        "command": "interviewPrep.showTracks",
        "title": "Group Lessons by Track",
        "category": "Interview Prep",
        "icon": "$(list-tree)"
      },
      {
        "command": "interviewPrep.showPath",
        "title": "List Lessons in Study Order",
        "category": "Interview Prep",
        "icon": "$(list-ordered)"
      },
      {
        "command": "interviewPrep.openVoiceTutor",
        "title": "Open Voice Tutor",
        "category": "Interview Prep",
        "icon": "$(mic)"
      },
      {
        "command": "interviewPrep.setGeminiApiKey",
        "title": "Set Gemini API Key",
        "category": "Interview Prep",
        "icon": "$(key)"
      },
      {
        "command": "interviewPrep.clearGeminiApiKey",
        "title": "Clear Gemini API Key",
        "category": "Interview Prep"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "interviewPrep.nextLesson",
          "when": "view == interviewPrep.lessons",
          "group": "navigation@1"
        },
        {
          "command": "interviewPrep.goToCurrentLesson",
          "when": "view == interviewPrep.lessons",
          "group": "navigation@2"
        },
        {
          "command": "interviewPrep.askClaude",
          "when": "view == interviewPrep.lessons && interviewPrep.isLocal",
          "group": "navigation@3"
        },
        {
          "command": "interviewPrep.chooseRole",
          "when": "view == interviewPrep.lessons",
          "group": "navigation@4"
        },
        {
          "command": "interviewPrep.chooseTracks",
          "when": "view == interviewPrep.lessons",
          "group": "navigation@4"
        },
        {
          "command": "interviewPrep.addTopic",
          "when": "view == interviewPrep.lessons",
          "group": "navigation@4"
        },
        {
          "command": "interviewPrep.showTracks",
          "when": "view == interviewPrep.lessons && interviewPrep.lessonView != tracks",
          "group": "navigation@5"
        },
        {
          "command": "interviewPrep.showPath",
          "when": "view == interviewPrep.lessons && interviewPrep.lessonView == tracks",
          "group": "navigation@5"
        },
        {
          "command": "interviewPrep.refresh",
          "when": "view == interviewPrep.lessons",
          "group": "navigation@6"
        }
      ],
      "commandPalette": [
        {
          "command": "interviewPrep.askClaude",
          "when": "interviewPrep.isLocal"
        },
        {
          "command": "interviewPrep.openVoiceTutor",
          "when": "interviewPrep.isLocal"
        },
        {
          "command": "interviewPrep.setGeminiApiKey",
          "when": "interviewPrep.isLocal"
        },
        {
          "command": "interviewPrep.clearGeminiApiKey",
          "when": "interviewPrep.isLocal"
        }
      ],
      "editor/title": [
        {
          "command": "interviewPrep.runTests",
          "when": "resourcePath =~ /[\\\\/]work[\\\\/]/",
          "group": "navigation@1"
        }
      ]
    },
    "configuration": {
      "title": "Interview Prep",
      "properties": {
        "interviewPrep.autoOpenNextLesson": {
          "type": "boolean",
          "default": true,
          "description": "Open the next unfinished lesson when the workspace loads"
        },
        "interviewPrep.role": {
          "type": "string",
          "default": "all",
          "description": "Show only the lessons that matter for this role: \"all\" or a role id from curriculum/roles.json. Pick one with Interview Prep: Choose Role"
        },
        "interviewPrep.tracks": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Study only these topics: track ids from curriculum/tracks.json. Empty means every topic. Pick them with Interview Prep: Choose Topics"
        },
        "interviewPrep.hotReload": {
          "type": "boolean",
          "default": false,
          "description": "Refresh lessons and reload the extension when their built files change (used by pnpm dev)"
        }
      }
    },
    "taskDefinitions": [
      {
        "type": "interviewPrep",
        "properties": {}
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "interviewPrep",
          "title": "Interview Prep",
          "icon": "media/icon.svg"
        }
      ],
      "panel": [
        {
          "id": "interviewPrepResults",
          "title": "Test Results",
          "icon": "media/icon.svg"
        }
      ]
    }
  },
  "activationEvents": [
    "workspaceContains:curriculum/tracks.json"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  }
}
