{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "types": ["node", "vscode"],
    "paths": {
      "@/*": ["./src/*"],
      "@scripts/*": ["../../scripts/*"],
      "@manifest": ["./package.json"]
    }
  },
  "include": ["src"]
}
