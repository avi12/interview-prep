{
  "name": "@interview-prep/gemini-live",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome extension: a Gemini Live voice tutor that watches the learner's VS Code tab",
  "license": "Apache-2.0",
  "type": "module",
  "imports": {
    "#imports": "./.wxt/types/imports-module.d.ts",
    "#src/*": "./src/*",
    "#tools/*": "./scripts/*",
    "#extension-identity": "./extension-identity.ts",
    "#vscode-origin": "./vscode-origin.ts",
    "#repo-scripts/*": "interview-prep/scripts/*"
  },
  "scripts": {
    "dev": "node scripts/dev.ts",
    "build": "wxt build",
    "build:voice": "vite build -c vite.voice.config.ts",
    "zip": "wxt zip",
    "compile": "wxt prepare && tsrs --noEmit && pnpm svelte:check",
    "postinstall": "wxt prepare",
    "test": "vitest run",
    "test:chain": "node test/run-chain.ts",
    "svelte:check": "svelte-check --tsconfig ./tsconfig.json --tsgo",
    "mic-key:install": "node scripts/install-mic-key-host.ts"
  },
  "dependencies": {
    "@webext-core/messaging": "^4.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.0.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@wxt-dev/module-svelte": "^2.0.5",
    "chokidar": "^5.0.0",
    "interview-prep": "link:../..",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "tsrs": "0.24.0-ts7.1.0-beta",
    "typescript": "^5.9.0",
    "vite": "^8.3.4",
    "vitest": "^3.2.0",
    "web-ext-run": "^0.2.4",
    "wxt": "^0.21.4"
  }
}
