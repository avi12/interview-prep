{
  "name": "@interview-prep/gemini-live",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Chrome extension: a Gemini Live voice tutor that watches the learner's VS Code tab",
  "license": "GPL-3.0-or-later",
  "imports": {
    "#imports": "./.wxt/types/imports-module.d.ts"
  },
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "compile": "wxt prepare && tsc --noEmit && pnpm svelte:check",
    "postinstall": "wxt prepare",
    "test": "vitest run",
    "test:chain": "node test/run-chain.ts",
    "lint": "oxlint --type-aware --fix -c .oxlintrc.fix.json && eslint --fix && oxlint --type-aware",
    "stylelint": "stylelint . --fix",
    "svelte:check": "svelte-check --tsconfig ./tsconfig.json --tsgo"
  },
  "dependencies": {
    "@webext-core/messaging": "^4.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.0.0",
    "@types/w3c-web-hid": "^1.0.7",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@wxt-dev/module-svelte": "^2.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-import-newlines": "^2.0.0",
    "eslint-plugin-perfectionist": "^5.13.0",
    "eslint-plugin-svelte": "^3.23.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.13.0",
    "oxlint": "1.72.0",
    "oxlint-tsgolint": "0.24.0",
    "postcss": "^8.5.30",
    "postcss-html": "^1.8.1",
    "stylelint": "^17.16.0",
    "stylelint-config-ccb": "^3.32.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "svelte-eslint-parser": "^1.9.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.0",
    "vitest": "^3.2.0",
    "wxt": "^0.21.4"
  }
}
