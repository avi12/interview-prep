{
  "name": "@interview-prep/web",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "The hosted trainer: VS Code in the browser with the course extension, test runners and optional Google sign-in",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "pnpm -C ../vscode-ext build && vite",
    "build": "pnpm -C ../vscode-ext build && vite build && node build-server.ts",
    "start": "node dist-server/server.js",
    "test": "vitest run",
    "test:browser-runner": "pnpm -w build && pnpm -w build:engines && vitest run -c vitest.browser-runner.config.ts",
    "compile": "tsrs --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@codingame/monaco-vscode-accessibility-service-override": "39.0.4",
