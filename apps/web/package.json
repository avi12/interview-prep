    "@codingame/monaco-vscode-dialogs-service-override": "39.0.4",
    "@codingame/monaco-vscode-environment-service-override": "39.0.4",
    "@codingame/monaco-vscode-explorer-service-override": "39.0.4",
    "@codingame/monaco-vscode-extensions-service-override": "39.0.4",
