    "@codingame/monaco-vscode-languages-service-override": "39.0.4",
    "@codingame/monaco-vscode-lifecycle-service-override": "39.0.4",
    "@codingame/monaco-vscode-log-service-override": "39.0.4",
    "@codingame/monaco-vscode-markdown-basics-default-extension": "39.0.4",
    "@codingame/monaco-vscode-markers-service-override": "39.0.4",
