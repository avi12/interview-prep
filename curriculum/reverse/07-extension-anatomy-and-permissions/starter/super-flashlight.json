{
  "manifest_version": 3,
  "name": "Super Flashlight",
  "description": "Turns your screen into a flashlight",
  "version": "9.1",
  "background": { "service_worker": "worker.js" },
  "permissions": ["cookies", "tabs", "storage", "debugger", "downloads"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["inject.js"] },
    { "matches": ["https://*.shop.test/*"], "js": ["shop.js"] }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'unsafe-eval' https://cdn.example.test; object-src 'self'"
  },
  "web_accessible_resources": [
    { "resources": ["inject.js"], "matches": ["<all_urls>"] },
    { "resources": ["logo.png"], "matches": ["https://shop.test/*"] }
  ]
}
